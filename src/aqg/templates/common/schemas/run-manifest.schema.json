{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/siraht/AgentGauntlet/blob/main/quality/schemas/run-manifest.schema.json",
  "title": "Agent Quality Gauntlet immutable run manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "completed_at", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,126}$"
    },
    "completed_at": { "type": "string", "format": "date-time" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
