{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/siraht/AgentGauntlet/blob/main/quality/schemas/gate-report.schema.json",
  "title": "Agent Quality Gauntlet v2 gate evidence",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "gate",
    "status",
    "exit_code",
    "raw_exit_code",
    "command",
    "started_at",
    "duration_ms",
    "timed_out",
    "revision",
    "base_ref",
    "change_fingerprint",
    "control_fingerprint",
    "stdout",
    "stderr"
  ],
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "gate": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": ["string", "null"]
    },
    "status": {
      "enum": [
        "pass",
        "quality_failure",
        "configuration_error",
        "infrastructure_error"
      ]
    },
    "exit_code": {
      "type": "integer",
      "enum": [0, 1, 2, 3]
    },
    "raw_exit_code": {
      "type": "integer"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "timed_out": {
      "type": "boolean"
    },
    "revision": {
      "type": "string"
    },
    "base_ref": {
      "type": "string"
    },
    "change_fingerprint": {
      "type": "string"
    },
    "control_fingerprint": {
      "type": "string"
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
