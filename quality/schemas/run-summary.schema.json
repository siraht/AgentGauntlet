{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/siraht/AgentGauntlet/blob/main/quality/schemas/run-summary.schema.json",
  "title": "Agent Quality Gauntlet profile-run summary",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "profile",
    "enforcement_stage",
    "mode",
    "status",
    "exit_code",
    "observed_exit_code",
    "measured_gate_exit_code",
    "command_status",
    "started_at",
    "duration_ms",
    "revision",
    "base_ref",
    "change_fingerprint",
    "control_fingerprint",
    "workspace_mutated",
    "start_change_fingerprint",
    "retrospective",
    "gates"
  ],
  "properties": {
    "schema_version": {"const": "2"},
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,126}$"
    },
    "profile": {"type": "string", "minLength": 1},
    "enforcement_stage": {"enum": ["shadow", "ratchet", "strict"]},
    "mode": {"enum": ["shadow", "enforce"]},
    "status": {
      "enum": ["pass", "quality_failure", "configuration_error", "infrastructure_error"]
    },
    "exit_code": {"type": "integer", "enum": [0, 1, 2, 3]},
    "observed_exit_code": {"type": "integer", "enum": [0, 1, 2, 3]},
    "measured_gate_exit_code": {"type": "integer", "enum": [0, 1, 2, 3]},
    "command_status": {
      "enum": ["pass", "quality_failure", "configuration_error", "infrastructure_error"]
    },
    "started_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "revision": {"type": "string"},
    "base_ref": {"type": "string"},
    "change_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "control_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "workspace_mutated": {"type": "boolean"},
    "start_change_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "retrospective": {
      "type": "object",
      "required": ["certification", "counts"],
      "properties": {
        "certification": {
          "enum": ["observations_only", "regression_free", "not_regression_free"]
        },
        "counts": {"type": "object"}
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "exit_code", "duration_ms"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {
            "enum": ["pass", "quality_failure", "configuration_error", "infrastructure_error"]
          },
          "exit_code": {"type": "integer", "enum": [0, 1, 2, 3]},
          "duration_ms": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
